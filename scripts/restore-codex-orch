#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if command -v uv >/dev/null 2>&1; then
  exec uv run --project "$REPO_ROOT" python -m tmux_dash.restore_codex_orch "$@"
fi

PYTHON=${PYTHON:-python3}
PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -m tmux_dash.restore_codex_orch "$@"
